# GitHub Linguist Language Override Configuration
# Continuum: 100% Pure Native Rust Memory Engine

# Treat all Python scripts (benchmarks, ablations, tests, and SDK adapters) as vendored / evaluation tooling
*.py linguist-vendored
*.py linguist-detectable=false
benchmarks/** linguist-vendored
benchmarks/** linguist-detectable=false
experiments/** linguist-vendored
experiments/** linguist-detectable=false
tests/** linguist-vendored
tests/** linguist-detectable=false
continuum/** linguist-vendored
continuum/** linguist-detectable=false
examples/** linguist-vendored
examples/** linguist-detectable=false
tools/** linguist-vendored
tools/** linguist-detectable=false

# Treat documentation, academic papers, and landing pages as documentation
paper/** linguist-documentation
paper/** linguist-detectable=false
docs/** linguist-documentation
docs/** linguist-detectable=false
install.sh linguist-documentation
install.sh linguist-detectable=false
Makefile linguist-documentation
Makefile linguist-detectable=false
*.html linguist-documentation
*.html linguist-detectable=false
*.tex linguist-documentation
*.tex linguist-detectable=false

# Ensure Native Rust Core & CLI in crates/ are the primary language
crates/** linguist-detectable=true
crates/**/*.rs linguist-detectable=true
